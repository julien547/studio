# This module does not start or stop the Pod. The other infrastructure session owns lifecycle.
# Leave both values empty to test upload, editing, persistence and SVG entirely on OVH.
DOEMO_RUNPOD_URL=
DOEMO_OVH_PRIVATE_KEY=
# When the existing private tunnel is ready, use its ACTUAL loopback port:
# DOEMO_RUNPOD_URL=http://127.0.0.1:8009
# DOEMO_OVH_PRIVATE_KEY=/etc/doemo-redessin/worker-signing-private.pem
# Alternatively use the private HTTPS service URL; TLS verification remains enabled.
# The signing key is Ed25519 PKCS8 PEM. Only the public key belongs on RunPod.
