[Unit]
Description=File de travaux CPU et GPU DOEMO Releves
After=network-online.target doemo-releves.service
Wants=network-online.target

[Service]
Type=simple
User=doemo-studio
Group=doemo-studio
WorkingDirectory=/opt/doemo-studio/src
EnvironmentFile=/etc/doemo-studio/releves.env
EnvironmentFile=-/etc/doemo-studio/runpod/runpod-ovh.env
ExecStart=/opt/doemo-studio-venv/bin/python -m doemo_releves.queue
Restart=on-failure
RestartSec=5
TimeoutStopSec=600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/doemo-studio/releves

[Install]
WantedBy=multi-user.target
