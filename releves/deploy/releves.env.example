# Backend OVH. Aucun secret dans ce modele.
DOEMO_RELEVES_DATA=/var/lib/doemo-studio/releves
DOEMO_RELEVES_DIST=/opt/doemo-studio/src/releves/dist
DOEMO_RELEVES_SOCKET=/run/doemo-studio/backend.sock
DOEMO_PUBLIC_ORIGIN=https://studio.doemo.fr
DOEMO_RUNPOD_MANAGED=0
# Le fichier optionnel runpod/runpod-ovh.env est charge APRES celui-ci.
# Ne jamais utiliser un nom VITE_* pour un secret.
# Facultatif, après recette GPU réelle : voir docs/ENTRAINEMENT-RTMDET.md.
# DOEMO_TRAINING_PROFILE=/etc/doemo-studio/runpod/rtmdet-training-profile.json

# Reconnaissance PaddleOCR : profil distinct après recette GPU réelle.
# Voir docs/ENTRAINEMENT-PADDLEOCR.md ; même contenu privé sur OVH et le Pod.
# DOEMO_PADDLE_TRAINING_PROFILE=/chemin/prive/paddle-training-profile.json

# Qwen LoRA : profil indépendant après recette GPU, voir docs/ENTRAINEMENT-QWEN.md.
# DOEMO_QWEN_TRAINING_PROFILE=/chemin/prive/qwen-training-profile.json
