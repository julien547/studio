# Backend OVH. Aucun secret dans ce modele.
DOEMO_RELEVES_DATA=/var/lib/doemo-studio/releves
DOEMO_RELEVES_DIST=/opt/doemo-studio/src/releves/dist
DOEMO_RELEVES_SOCKET=/run/doemo-studio/backend.sock
DOEMO_PUBLIC_ORIGIN=https://studio.doemo.fr
DOEMO_RUNPOD_MANAGED=0
# Le fichier optionnel runpod/runpod-ovh.env est charge APRES celui-ci.
# Ne jamais utiliser un nom VITE_* pour un secret.

# Plan unifie : raccorder le moteur deja installe, apres verification des chemins.
# Inactif tant que ces deux variables ne sont pas definies ; les outils manuels restent disponibles.
# DOEMO_STRUCTURE_PYTHON=/chemin/verifie/venv-redessin/bin/python
# DOEMO_STRUCTURE_MODULE_PATH=/chemin/verifie/reconstruction
# Le modele de murs est une configuration distincte du worker (DOEMO_WALLS_MODEL_DIR,
# DOEMO_WALLS_PYTHON, etc.). Ne pas changer ses valeurs ou telecharger des poids ici.
