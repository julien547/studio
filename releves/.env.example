# Configuration du service Python (jamais une clé réelle dans ce fichier).
DOEMO_RELEVES_DATA=/var/lib/doemo-studio/releves
DOEMO_RELEVES_SOCKET=/var/run/doemo-releves/backend.sock
DOEMO_RELEVES_DIST=/opt/doemo-studio/src/releves/dist
DOEMO_VISION_ENDPOINT=https://api.openai.com/v1/chat/completions
DOEMO_VISION_MODEL=gpt-4.1
# Fournir DOEMO_VISION_API_KEY dans les paramètres sécurisés, pas dans Git.

# Mode autonome optionnel, séparé de la session PHP existante.
DOEMO_PUBLIC_ORIGIN=http://127.0.0.1:8082
DOEMO_STUDIO_PORT=8082
DOEMO_RELEVES_PYTHON=/opt/doemo-studio-venv/bin/python
# En exploitation HTTPS : DOEMO_PUBLIC_ORIGIN=https://studio.doemo.fr

# Facultatif : endpoint HTTPS du gateway sur le Pod (modifiable sans changer le code).
# Laisser absent pour travailler sans GPU.
# DOEMO_RUNPOD_ENDPOINT=https://endpoint-prive-a-configurer
# DOEMO_RUNPOD_TOKEN : secret à configurer hors dépôt, jamais côté frontend.
# Sur le Pod uniquement :
DOEMO_QWEN_MODEL=/workspace/doemo-studio/models/qwen/Qwen3.5-9B
# DOEMO_PADDLE_DETECTION_MODEL=/chemin/du/modele/detection/deja/installe
# DOEMO_PADDLE_RECOGNITION_MODEL=/chemin/du/modele/reconnaissance/deja/installe
# DOEMO_RTMDET_CONFIG=/workspace/doemo-studio/models/rtmdet/config.py
# DOEMO_RTMDET_WEIGHTS=/workspace/doemo-studio/models/rtmdet/checkpoint.pth
UV_CACHE_DIR=/tmp/doemo-uv-cache
PIP_CACHE_DIR=/tmp/doemo-pip-cache

# Gestion RunPod REST v2 — configuration EXCLUSIVEMENT sur le backend OVH.
# RUNPOD_API_KEY : secret OVH, ne jamais le copier au Pod ou au frontend.
DOEMO_RUNPOD_MANAGED=0
# Renseigner l’identifiant actuel depuis RunPod, il peut changer après migration.
DOEMO_RUNPOD_POD_ID=
DOEMO_RUNPOD_POD_NAME=DOEMO-STUDIO-IA
DOEMO_RUNPOD_GATEWAY_PORT=8000
DOEMO_RUNPOD_AUTOSTART=1
DOEMO_RUNPOD_AUTOSTOP=1
# Activer MANAGED=1 après configuration de la clé OVH et du bootstrap persistant.
# L’inactivité est fixée à 1800 secondes ; les tâches actives/en attente interdisent l’arrêt.
# Pod seulement :
DOEMO_PERSISTENT_ROOT=/workspace/doemo-studio
DOEMO_RESTORE_MANIFEST=/workspace/doemo-studio/restore/current/manifest.json
# DOEMO_RUNTIME_IMAGE_TAG : même image de conteneur pour sauvegarde/restauration.

# Entraînement RTMDet : absent par défaut. Profil produit par accept_training.py
# après recette GPU réelle ; même contenu de profil sur OVH et sur le Pod.
# DOEMO_TRAINING_PROFILE=/chemin/prive/rtmdet-training-profile.json

# Reconnaissance PaddleOCR : profil distinct après recette GPU réelle.
# Voir docs/ENTRAINEMENT-PADDLEOCR.md ; même contenu privé sur OVH et le Pod.
# DOEMO_PADDLE_TRAINING_PROFILE=/chemin/prive/paddle-training-profile.json
